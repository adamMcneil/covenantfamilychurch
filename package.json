{
  "name": "covenantfamilychurch",
  "private": true,
  "version": "1.0.0",
  "description": "Covenant Family Church (OPC, Wentzville, MO) website: static rebuild of covenantfamilychurch.net",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy && pagefind --site _site --output-subdir pagefind",
    "check": "node scripts/check-site.mjs",
    "icon-art": "node scripts/icon-art.mjs",
    "import": "node scripts/import-wordpress.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "pagefind": "^1.3.0",
    "sharp": "^0.35.5",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
